{
  "name": "flattybot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run 'src/tests/**/*.integration.test.ts'",
    "test:e2e": "NODE_ENV=development vitest run --config vitest-e2e.config.ts",
    "e2e:pull-snapshot": "NODE_ENV=development ts-node tests/cli/pull-db-snapshot.ts",
    "start": "NODE_ENV=production ts-node src/index.ts",
    "build": "tsc",
    "dev": "NODE_ENV=development nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "filter-test": "NODE_ENV=development ts-node src/tools/filter-tester.ts",
    "eval": "NODE_ENV=development ts-node tests/cli/flattybot-eval.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "grammy": "^1.38.4",
    "openai": "^6.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "nodemon": "^3.1.11",
    "vitest": "^3.2.4"
  }
}
